<div style="
    font-family: Arial, sans-serif; 
    max-width: 600px; 
    margin: auto; 
    padding: 20px; 
    border: 1px solid #ddd; 
    border-radius: 8px; 
    background-color: #f9f9f9;
">
    <h1 style="color: #333; text-align: center;">Order Status: <%= status %></h1>

    <p style="font-size: 16px; color: #555; text-align: center;">
        Your order for <strong style="color: #000;"><%= carName %></strong> has been <strong style="color: #007bff;"><%= status %></strong>.
    </p>

    <div style="background: #fff; padding: 15px; border-radius: 6px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); margin-top: 20px;">
        <h2 style="color: #333; border-bottom: 2px solid #007bff; padding-bottom: 5px;">Your Details</h2>
        <p style="font-size: 16px; color: #555;"><strong>Name:</strong> <%= userName %></p>
        <p style="font-size: 16px; color: #555;"><strong>Address:</strong> <%= address %></p>
    </div>

    <div style="background: #fff; padding: 15px; border-radius: 6px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); margin-top: 20px;">
        <h2 style="color: #333; border-bottom: 2px solid #007bff; padding-bottom: 5px;">Car Details</h2>
        <p style="font-size: 16px; color: #555;"><strong>Name:</strong> <%= carName %></p>
        <p style="font-size: 16px; color: #555;"><strong>Address:</strong> <%= price %></p>
    </div>

    <p style="font-size: 14px; color: #777; text-align: center; margin-top: 20px;">
        Thank you for choosing us! If you have any questions, feel free to contact us.
    </p>

    <!-- <div style="text-align: center; margin-top: 20px;">
        <a href="https://yourwebsite.com/orders" 
            style="
                display: inline-block; 
                background: #007bff; 
                color: white; 
                text-decoration: none; 
                padding: 10px 20px; 
                border-radius: 5px; 
                font-size: 16px;
            ">
            View Your Order
        </a>
    </div> -->
</div>
